{
  "version": "1.0",
  "domain": "Retail banking / UPI customer support (India). All tools are mocked in src/desi_agent/tools.py.",
  "argument_language_rule": "Argument VALUES are always canonical: English enum values, ASCII digits, ISO dates. The user may write in any language/script; the agent must normalise (e.g. 'চার হাজার' -> 4000, 'khoya' -> 'lost').",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_account_balance",
        "description": "Get the current balance of one of the customer's accounts.",
        "parameters": {
          "type": "object",
          "properties": {
            "account_type": {"type": "string", "enum": ["savings", "current", "credit_card"]}
          },
          "required": ["account_type"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_recent_transactions",
        "description": "List the customer's most recent transactions, newest first.",
        "parameters": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 1, "maximum": 20},
            "txn_type": {"type": "string", "enum": ["all", "debit", "credit"]}
          },
          "required": ["count"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "block_card",
        "description": "Immediately block a debit or credit card. Irreversible from chat.",
        "parameters": {
          "type": "object",
          "properties": {
            "card_last4": {"type": "string", "pattern": "^[0-9]{4}$"},
            "reason": {"type": "string", "enum": ["lost", "stolen", "fraud", "damaged"]}
          },
          "required": ["card_last4", "reason"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "raise_dispute",
        "description": "Raise a dispute for a specific transaction.",
        "parameters": {
          "type": "object",
          "properties": {
            "transaction_id": {"type": "string", "pattern": "^TXN[0-9]{6}$"},
            "reason": {"type": "string", "enum": ["not_received", "duplicate", "unauthorized", "wrong_amount"]}
          },
          "required": ["transaction_id", "reason"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_upi_status",
        "description": "Check the status of a UPI payment by its 12-digit UPI reference number (UTR).",
        "parameters": {
          "type": "object",
          "properties": {
            "upi_ref": {"type": "string", "pattern": "^[0-9]{12}$"}
          },
          "required": ["upi_ref"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "transfer_money",
        "description": "Send money by UPI. Only call when BOTH payee UPI id and amount are explicitly given by the user; otherwise ask.",
        "parameters": {
          "type": "object",
          "properties": {
            "to_upi_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{2,64}@[a-zA-Z]{2,32}$"},
            "amount": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
            "note": {"type": "string", "maxLength": 50}
          },
          "required": ["to_upi_id", "amount"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "find_nearest_branch",
        "description": "Find the nearest branch or ATM for an Indian 6-digit PIN code.",
        "parameters": {
          "type": "object",
          "properties": {
            "pincode": {"type": "string", "pattern": "^[1-9][0-9]{5}$"},
            "kind": {"type": "string", "enum": ["branch", "atm"]}
          },
          "required": ["pincode"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_loan_emi",
        "description": "Compute the monthly EMI for a loan.",
        "parameters": {
          "type": "object",
          "properties": {
            "principal": {"type": "number", "exclusiveMinimum": 0},
            "annual_rate_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
            "tenure_months": {"type": "integer", "minimum": 1, "maximum": 480}
          },
          "required": ["principal", "annual_rate_pct", "tenure_months"],
          "additionalProperties": false
        }
      }
    }
  ]
}
